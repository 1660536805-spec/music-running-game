  "lyrics": [
    {
      "t": 0,
      "end": 3.233,
      "text": "我自娱自乐，荣辱不惊",
      "kind": "verse"
    },
    {
      "t": 3.233,
      "end": 7.333,
      "text": "事了拂衣去，深藏功名",
      "kind": "verse"
    },
    {
      "t": 7.333,
      "end": 10.1,
      "text": "以梦为码，仗键横行",
      "kind": "verse"
    },
    {
      "t": 10.1,
      "end": 13.967,
      "text": "痛快Hacking，激情Coding",
      "kind": "verse"
    },
    {
      "t": 13.967,
      "end": 17.633,
      "text": "有朋自远方来，不亦乐乎",
      "kind": "preChorus"
    },
    {
      "t": 17.633,
      "end": 21.0,
      "text": "志同道合，吾道不孤",
      "kind": "preChorus"
    },
    {
      "t": 21.0,
      "end": 24.433,
      "text": "面对屏幕，遥想当初",
      "kind": "chorus"
    },
    {
      "t": 24.433,
      "end": 30.433,
      "text": "少年志气，咬牙不服输",
      "kind": "outro"
    }
  ],
