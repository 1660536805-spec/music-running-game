  "lyrics": [
    {
      "t": 0,
      "end": 3.7,
      "text": "On a streetcar in Tacoma, on a Sunday in July",
      "kind": "verse"
    },
    {
      "t": 3.7,
      "end": 7.7,
      "text": "You're kicking off your sandals, as you stare up at the sky",
      "kind": "verse"
    },
    {
      "t": 7.7,
      "end": 11.5,
      "text": "I look at you and fumble, for the perfect thing to say",
      "kind": "verse"
    },
    {
      "t": 11.5,
      "end": 14.2,
      "text": "But my nerves get in the way",
      "kind": "verse"
    },
    {
      "t": 14.2,
      "end": 18.6,
      "text": "I've cherished you for ages, but my words were locked in cages",
      "kind": "preChorus"
    },
    {
      "t": 18.6,
      "end": 22.4,
      "text": "So afraid that you just saw me as a friend",
      "kind": "preChorus"
    },
    {
      "t": 22.4,
      "end": 26.8,
      "text": "Now I want to set them free, my fingers clenching to the key",
      "kind": "chorus"
    },
    {
      "t": 26.8,
      "end": 31,
      "text": "But I am frozen once again",
      "kind": "outro"
    }
  ],
